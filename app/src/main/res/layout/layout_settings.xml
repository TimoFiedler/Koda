<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FF000000">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Profil" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-black" android:layout_marginBottom="4dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dark Reference - SCALA" android:textSize="13sp" android:textColor="#FF8E8E93" android:layout_marginBottom="20dp" />

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:backgroundTint="#FF1C1C1E" android:layout_marginBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="FIN / VIN" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginBottom="12dp" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" app:boxStrokeColor="#FF2C2C2E" app:hintTextColor="#FF8E8E93">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFinSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="API-Key" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginBottom="12dp" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" app:boxStrokeColor="#FF2C2C2E" app:hintTextColor="#FF8E8E93">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etApiKeySettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Auto Modell z.B. SCALA" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginBottom="12dp" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" app:boxStrokeColor="#FF2C2C2E" app:hintTextColor="#FF8E8E93">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCarModelSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" android:text="SCALA" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/tvRateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rate Limit: 20/20" android:textSize="11sp" android:textColor="#FF8E8E93" android:layout_marginBottom="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveProfile" android:layout_width="match_parent" android:layout_height="48dp" android:text="Profil speichern" app:cornerRadius="12dp" android:backgroundTint="#FF6ECFC3" android:textColor="#FF000000" android:textStyle="bold" android:layout_marginBottom="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPickProfileImage" android:layout_width="match_parent" android:layout_height="48dp" android:text="Profilbild wählen (türkis)" app:cornerRadius="12dp" android:backgroundTint="#FF2C2C2E" android:textColor="#FFFFFFFF" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:backgroundTint="#FF1C1C1E" android:layout_marginBottom="16dp">
        <RadioGroup android:id="@+id/rgEngineSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
            <RadioButton android:id="@+id/rbElectricSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Elektro" android:textColor="#FFFFFFFF" android:padding="10dp" />
            <RadioButton android:id="@+id/rbCombustionSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Verbrenner" android:textColor="#FFFFFFFF" android:padding="10dp" />
            <RadioButton android:id="@+id/rbHybridSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hybrid" android:textColor="#FFFFFFFF" android:padding="10dp" />
        </RadioGroup>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:backgroundTint="#FF1C1C1E" android:layout_marginBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Farben - Dark Reference" android:textSize="12sp" android:textColor="#FF8E8E93" android:layout_marginBottom="12dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="#6ECFC3 oder Name" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginBottom="12dp" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" app:boxStrokeColor="#FF2C2C2E" app:hintTextColor="#FF8E8E93">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCustomBg" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFFFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Akzent #6ECFC3" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginBottom="16dp" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" app:boxStrokeColor="#FF2C2C2E" app:hintTextColor="#FF8E8E93">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCustomAccent" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFFFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>
            <View android:id="@+id/viewColorPreview" android:layout_width="match_parent" android:layout_height="48dp" android:background="#FF2C2C2E" android:layout_marginBottom="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveColors" android:layout_width="match_parent" android:layout_height="48dp" android:text="Farben anwenden" app:cornerRadius="12dp" android:backgroundTint="#FF6ECFC3" android:textColor="#FF000000" android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:backgroundTint="#FF1C1C1E" android:layout_marginBottom="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Automatisch" android:textSize="14sp" android:textColor="#FFFFFFFF" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Startet ab Schwelle" android:textSize="11sp" android:textColor="#FF8E8E93" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swAutoTripSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="#FF6ECFC3" app:trackTint="#FF2C2C2E" />
            </LinearLayout>
            <RadioGroup android:id="@+id/rgThreshold" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <RadioButton android:id="@+id/rbThresh10" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10 km/h" android:textColor="#FFFFFFFF" />
                <RadioButton android:id="@+id/rbThresh15" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="15 km/h" android:checked="true" android:textColor="#FFFFFFFF" />
                <RadioButton android:id="@+id/rbThresh25" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="25 km/h" android:textColor="#FFFFFFFF" />
            </RadioGroup>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="52dp" android:text="Abmelden" app:cornerRadius="16dp" android:backgroundTint="#FF1C1C1E" android:textColor="#FFFF3B30" />

</LinearLayout>
