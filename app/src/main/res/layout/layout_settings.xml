<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/cream_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Profil"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:letterSpacing="0.02"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fahrzeug und Konto"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/cream_border"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verbundenes Fahrzeug"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/text_hint"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvSettingsInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Antriebsart"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textColor="@color/text_hint"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/cream_border"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <RadioGroup
                android:id="@+id/rgEngineSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbElectricSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Elektro - Zeigt Akku % und Ladezustand"
                    android:textSize="14sp"
                    android:padding="12dp" />

                <RadioButton
                    android:id="@+id/rbCombustionSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Verbrenner - Zeigt Tank % und Reichweite"
                    android:textSize="14sp"
                    android:padding="12dp" />

                <RadioButton
                    android:id="@+id/rbHybridSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hybrid / PHEV - Zeigt beides"
                    android:textSize="14sp"
                    android:padding="12dp" />

            </RadioGroup>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Design"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textColor="@color/text_hint"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/cream_border"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="App Farbschema"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/rgAppTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbThemeCreme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Creme - Warm und hell"
                    android:checked="true"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbThemeSand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sand - Helles Beige"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbThemeMocca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mocca - Kuehles Grau-Beige"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbThemeGraphite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Graphit - Minimal und modern"
                    android:textSize="14sp" />

            </RadioGroup>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fahrtenbuch"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textColor="@color/text_hint"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/cream_border"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Automatische Erkennung"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Startet Fahrt bei Bewegung"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAutoTripSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Schwelle"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgThreshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbThresh10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="10 km/h"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbThresh15"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="15 km/h"
                    android:checked="true"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbThresh25"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="25 km/h"
                    android:textSize="13sp" />

            </RadioGroup>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:backgroundTint="@color/beige_light"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Information"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/brown_dark"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SkodaDash Ultra\nVersion 2.0 - Premium Creme\n\nOffizielle API: public.api.connect.skoda-auto.cz\nLimit: 20 Anfragen pro Stunde\nWidget: 15 Minuten Intervall\nFahrtenbuch: GPS 1Hz, Auto-Erkennung, linearer Beschleunigungssensor"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Abmelden und Daten loeschen"
        android:textSize="13sp"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/cream_card"
        android:textColor="@color/error_muted"
        app:strokeWidth="1dp"
        app:strokeColor="@color/cream_border"
        app:elevation="0dp"
        style="@style/Widget.Material3.Button.OutlinedButton" />

</LinearLayout>
