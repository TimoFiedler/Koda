<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FF000000">

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:backgroundTint="#FF1C1C1E" android:layout_marginBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Willkommen" android:textSize="26sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-black" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dark Reference - Verbinde dein Fahrzeug" android:textSize="13sp" android:textColor="#FF8E8E93" android:layout_marginTop="6dp" />
            <View android:layout_width="40dp" android:layout_height="3dp" android:background="#FF6ECFC3" android:layout_marginTop="16dp" android:layout_marginBottom="20dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="API-Key" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginBottom="12dp" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" app:boxStrokeColor="#FF2C2C2E" app:hintTextColor="#FF8E8E93">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etApiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="FIN / VIN" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginBottom="16dp" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" app:boxStrokeColor="#FF2C2C2E" app:hintTextColor="#FF8E8E93">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etVin" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>
            <RadioGroup android:id="@+id/rgEngineType" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">
                <RadioButton android:id="@+id/rbElectric" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Elektro" android:checked="true" android:textColor="#FFFFFFFF" />
                <RadioButton android:id="@+id/rbCombustion" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Verbrenner" android:textColor="#FFFFFFFF" />
                <RadioButton android:id="@+id/rbHybrid" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Hybrid" android:textColor="#FFFFFFFF" />
            </RadioGroup>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="56dp" android:text="Verbinden" app:cornerRadius="16dp" android:backgroundTint="#FF6ECFC3" android:textColor="#FF000000" android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="0dp" android:backgroundTint="#FF1C1C1E">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="API-Key erhalten" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:textAllCaps="true" android:layout_marginBottom="10dp" />
            <TextView android:id="@+id/tvHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#FF8E8E93" android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
