<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FF000000">

    <!-- Profil Header mit Bild wählbar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        android:backgroundTint="#FF1C1C1E"
        android:layout_marginBottom="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp">

            <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:layout_marginEnd="16dp">
                <ImageView android:id="@+id/ivProfile" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/card_dark_accent" android:scaleType="centerCrop" android:clipToOutline="true" />
                <View android:layout_width="56dp" android:layout_height="56dp" android:background="#40000000" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_car" android:tint="#FFFFFFFF" android:alpha="0.9" />
            </FrameLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/tvEngineBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SCALA" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-black" />
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:src="@drawable/ic_car" android:tint="#FF8E8E93" />
                </LinearLayout>
                <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Germany - Scala" android:textSize="12sp" android:textColor="#FF8E8E93" android:layout_marginTop="2dp" />
                <TextView android:id="@+id/tvCarModelLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tippe zum Ändern" android:textSize="10sp" android:textColor="#FF6ECFC3" android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/tvRange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reichweite" android:textSize="11sp" android:textColor="#FF8E8E93" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Fahrzeug Stats - echte Icons statt Emojis -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:backgroundTint="#FF1C1C1E" android:layout_marginEnd="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_fuel" android:tint="#FF6ECFC3" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/tvBattery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                <TextView android:id="@+id/tvBatteryLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tank" android:textSize="11sp" android:textColor="#FF8E8E93" android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:backgroundTint="#FF1C1C1E" android:layout_marginStart="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_range" android:tint="#FF30D158" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/tvRangeTile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reichweite" android:textSize="11sp" android:textColor="#FF8E8E93" android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:backgroundTint="#FF1C1C1E" android:layout_marginEnd="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_odometer" android:tint="#FFFF9F0A" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/tvOdo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kilometerstand" android:textSize="11sp" android:textColor="#FF8E8E93" android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:backgroundTint="#FF1C1C1E" android:layout_marginStart="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_lock" android:tint="#FFAF52DE" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/tvLock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status" android:textSize="11sp" android:textColor="#FF8E8E93" android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:backgroundTint="#FF1C1C1E" android:layout_marginEnd="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_bolt" android:tint="#FF6ECFC3" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/tvCharging" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:maxLines="2" />
                <TextView android:id="@+id/tvRateLimit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20/20" android:textSize="10sp" android:textColor="#FF8E8E93" android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:backgroundTint="#FF1C1C1E" android:layout_marginStart="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_speed" android:tint="#FFFF3B30" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/tvEngineBadge2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SCALA" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modell" android:textSize="11sp" android:textColor="#FF8E8E93" android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton android:id="@+id/btnRefresh" android:layout_width="match_parent" android:layout_height="52dp" android:text="Aktualisieren" app:cornerRadius="16dp" android:backgroundTint="#FF1C1C1E" android:textColor="#FFFFFFFF" app:strokeWidth="0dp" android:layout_marginBottom="20dp" />

    <!-- Tracker Section - nur Tracker ohne 0 Punkte Beschreibung -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fahrten Tracker" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-black" android:layout_marginBottom="12dp" />

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="0dp" android:backgroundTint="#FF1C1C1E" android:layout_marginBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tracker" android:textSize="16sp" android:textColor="#FFFFFFFF" android:textStyle="bold" />
                <TextView android:id="@+id/tvAutoStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bereit" android:textSize="11sp" android:textColor="#FF8E8E93" android:background="#FF2C2C2E" android:paddingHorizontal="10dp" android:paddingVertical="4dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnStartTrip" android:layout_width="match_parent" android:layout_height="52dp" android:text="Fahrt starten" app:cornerRadius="16dp" android:backgroundTint="#FFFFFFFF" android:textColor="#FF000000" app:elevation="0dp" android:layout_marginBottom="10dp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnStopTrip" android:layout_width="match_parent" android:layout_height="52dp" android:text="Fahrt beenden" app:cornerRadius="16dp" android:backgroundTint="#FF2C2C2E" android:textColor="#FFFFFFFF" app:strokeWidth="0dp" app:elevation="0dp" android:layout_marginBottom="16dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FF2C2C2E" android:layout_marginBottom="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Automatisch" android:textSize="14sp" android:textColor="#FFFFFFFF" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start ab Schwelle" android:textSize="11sp" android:textColor="#FF8E8E93" android:layout_marginTop="2dp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swAutoTrip" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="#FF6ECFC3" app:trackTint="#FF2C2C2E" />
            </LinearLayout>

            <TextView android:id="@+id/tvTrackerStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
