<resources>
    <!-- Dark Reference Theme - from screenshots -->
    <style name="Theme.SkodaDash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorPrimaryVariant">@color/accent_teal_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/card_dark</item>
        <item name="colorSecondaryVariant">@color/card_dark3</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorSurface">@color/card_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/card_dark3</item>
        <item name="colorOnSurfaceVariant">@color/text_gray</item>
        <item name="colorOutline">@color/card_border_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.SkodaDash.WidgetConfig" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/card_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="TextAppearance.SkodaDash.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SkodaDash.CardValue" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
